<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AMApplicationBuild</key>
	<string>534</string>
	<key>AMApplicationVersion</key>
	<string>2.10</string>
	<key>AMDocumentVersion</key>
	<string>2</string>
	<key>actions</key>
	<array>
		<dict>
			<key>action</key>
			<dict>
				<key>AMAccepts</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Optional</key>
					<true/>
					<key>Types</key>
					<array>
						<string>com.apple.cocoa.string</string>
					</array>
				</dict>
				<key>AMActionVersion</key>
				<string>2.0.3</string>
				<key>AMApplication</key>
				<array>
					<string>Automator</string>
				</array>
				<key>AMParameterProperties</key>
				<dict>
					<key>COMMAND_STRING</key>
					<dict/>
					<key>CheckedForUserDefaultShell</key>
					<dict/>
					<key>inputMethod</key>
					<dict/>
					<key>shell</key>
					<dict/>
					<key>source</key>
					<dict/>
				</dict>
				<key>AMProvides</key>
				<dict>
					<key>Container</key>
					<string>List</string>
					<key>Types</key>
					<array>
						<string>com.apple.cocoa.string</string>
					</array>
				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Kabuk Betiğini Çalıştır</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>osascript -e 'display notification "Sistem ve uygulama önbellekleri temizleniyor... Lütfen işlemin bitmesini bekleyin." with title "PC Temizleme Başladı 🚀"'

# ─────────────────────────────────────────────
# SYSDATA (Sistem Verileri Temizleyici)
# ─────────────────────────────────────────────
SYSDATA_DIR="$HOME/.sysdata-cleaner"
if [ ! -f "$SYSDATA_DIR/sysdata" ]; then
    mkdir -p "$SYSDATA_DIR"
    curl -sL https://raw.githubusercontent.com/Jarvis322/macos-sysdata/main/sysdata -o "$SYSDATA_DIR/sysdata" 2&gt;/dev/null
    chmod +x "$SYSDATA_DIR/sysdata"
fi
"$SYSDATA_DIR/sysdata" clean --yes 2&gt;/dev/null

# ─────────────────────────────────────────────
# ADOBE — Tüm Uygulamalar, Tüm Versiyonlar
# ─────────────────────────────────────────────

# Shared Media Cache (Premiere / AME)
rm -rf ~/Library/Application\ Support/Adobe/Common/Media\ Cache\ Files/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/Adobe/Common/Media\ Cache/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/Adobe/Common/Peak\ Files/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/Adobe/Common/PTX/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/Adobe/Common/Cache/* 2&gt;/dev/null

# Premiere Pro — Proje Önbellekleri
rm -rf ~/Documents/Adobe/Premiere\ Pro/*/Profile-*/Media\ Cache\ Files/* 2&gt;/dev/null
rm -rf ~/Documents/Adobe/Premiere\ Pro/*/Profile-*/Media\ Cache/* 2&gt;/dev/null

# After Effects
find ~/Library/Application\ Support/Adobe/ -type d -name "Disk Cache" -exec rm -rf {}/* \; 2&gt;/dev/null
find ~/Library/Application\ Support/Adobe/ -type d -name "preview" -path "*/After Effects/*" -exec rm -rf {}/* \; 2&gt;/dev/null
find ~/Library/Application\ Support/Adobe/ -type d -name "temp" -path "*/After Effects/*" -exec rm -rf {}/* \; 2&gt;/dev/null
rm -rf ~/Library/Caches/Adobe/After\ Effects/* 2&gt;/dev/null

# Photoshop
find ~/Library/Application\ Support/Adobe/ -type d -name "AutoRecover" -exec rm -rf {}/* \; 2&gt;/dev/null
find ~/Library/Application\ Support/Adobe/ -type d -name "Temp" -path "*/Photoshop*" -exec rm -rf {}/* \; 2&gt;/dev/null

# Lightroom Classic
rm -rf ~/Library/Caches/com.adobe.LightroomClassicCC7/* 2&gt;/dev/null
find ~/Pictures -maxdepth 2 -name "*.lrdata" -exec rm -rf {}/* \; 2&gt;/dev/null

# Lightroom CC
rm -rf ~/Library/Application\ Support/com.adobe.LightRoom/Caches/* 2&gt;/dev/null

# Audition
find ~/Library/Application\ Support/Adobe/ -type d -name "Autosave" -path "*/Audition*" -exec rm -rf {}/* \; 2&gt;/dev/null
find ~/Library/Application\ Support/Adobe/ -type d -name "Peaks" -exec rm -rf {}/* \; 2&gt;/dev/null

# InDesign
find ~/Library/Application\ Support/Adobe/ -type d -name "InDesign Recovery" -exec rm -rf {}/* \; 2&gt;/dev/null

# Media Encoder
find ~/Library/Application\ Support/Adobe/ -type d -name "surround" -exec rm -rf {}/* \; 2&gt;/dev/null
find ~/Library/Application\ Support/Adobe/ -type d -name "Logs" -path "*/Media Encoder*" -exec rm -rf {}/* \; 2&gt;/dev/null

# Bridge
rm -rf ~/Library/Caches/Adobe/Bridge\ CC/* 2&gt;/dev/null
rm -rf ~/Library/Caches/com.adobe.bridgeCC/* 2&gt;/dev/null

# Acrobat / Reader
rm -rf ~/Library/Caches/Adobe/Acrobat/* 2&gt;/dev/null
rm -rf ~/Library/Caches/com.adobe.Reader/* 2&gt;/dev/null
rm -rf ~/Library/Caches/com.adobe.Acrobat.Pro/* 2&gt;/dev/null

# Character Animator
find ~/Library/Application\ Support/Adobe/ -type d -name "Cache" -path "*/Character Animator*" -exec rm -rf {}/* \; 2&gt;/dev/null

# Substance 3D (Painter, Designer, Sampler, Stager)
find ~/Library/Application\ Support/ -maxdepth 1 -type d -name "Adobe Substance*" | while read d; do
    rm -rf "$d/cache/"* 2&gt;/dev/null
    rm -rf "$d/temp/"* 2&gt;/dev/null
done

# Camera Raw
rm -rf ~/Library/Caches/Adobe\ Camera\ Raw/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/Adobe/CameraRaw/Cache/* 2&gt;/dev/null

# Creative Cloud App / CoreSync
rm -rf ~/Library/Logs/Adobe/CoreSync/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/Adobe/OOBE/Logs/* 2&gt;/dev/null
find ~/Library/Application\ Support/Adobe/UPI -type d -name "cache" -exec rm -rf {}/* \; 2&gt;/dev/null

# Dynamic Link
find ~/Library/Application\ Support/Adobe/dynamiclinkmediaserver -type d -name "cache" -exec rm -rf {}/* \; 2&gt;/dev/null

# Genel Adobe
rm -rf ~/Library/Logs/Adobe/* 2&gt;/dev/null
find ~/Library/Application\ Support/Adobe -type d -name "Scratch" -exec rm -rf {}/* \; 2&gt;/dev/null
rm -rf ~/Library/Caches/Adobe/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/com.adobe.dunamis/cache/* 2&gt;/dev/null

# ─────────────────────────────────────────────
# DaVinci Resolve
# ─────────────────────────────────────────────
rm -rf ~/Movies/CacheClip/* 2&gt;/dev/null
rm -rf ~/Movies/.gallery/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/Blackmagic\ Design/DaVinci\ Resolve/Cache/* 2&gt;/dev/null

# ─────────────────────────────────────────────
# Xcode / iOS Developer
# ─────────────────────────────────────────────
rm -rf ~/Library/Developer/Xcode/DerivedData/* 2&gt;/dev/null
rm -rf ~/Library/Developer/CoreSimulator/Caches/* 2&gt;/dev/null
rm -rf ~/Library/Developer/Xcode/iOS\ DeviceSupport/* 2&gt;/dev/null
rm -rf ~/Library/Developer/Xcode/watchOS\ DeviceSupport/* 2&gt;/dev/null
rm -rf ~/Library/Developer/Xcode/tvOS\ DeviceSupport/* 2&gt;/dev/null
command -v xcrun &gt;/dev/null 2&gt;&amp;1 &amp;&amp; xcrun simctl delete unavailable 2&gt;/dev/null

# ─────────────────────────────────────────────
# Package Managers
# ─────────────────────────────────────────────
command -v brew &gt;/dev/null 2&gt;&amp;1 &amp;&amp; brew cleanup -s 2&gt;/dev/null &amp;&amp; brew autoremove 2&gt;/dev/null
command -v npm &gt;/dev/null 2&gt;&amp;1 &amp;&amp; npm cache clean --force 2&gt;/dev/null
command -v pip3 &gt;/dev/null 2&gt;&amp;1 &amp;&amp; pip3 cache purge 2&gt;/dev/null
command -v uv &gt;/dev/null 2&gt;&amp;1 &amp;&amp; uv cache clean 2&gt;/dev/null
command -v pnpm &gt;/dev/null 2&gt;&amp;1 &amp;&amp; pnpm store prune 2&gt;/dev/null
command -v yarn &gt;/dev/null 2&gt;&amp;1 &amp;&amp; yarn cache clean 2&gt;/dev/null
rm -rf ~/.gradle/caches/* 2&gt;/dev/null
rm -rf ~/.cargo/registry/cache/* ~/.cargo/registry/src/* 2&gt;/dev/null
rm -rf ~/Library/Caches/CocoaPods/* 2&gt;/dev/null
rm -rf ~/Library/Caches/org.swift.swiftpm/* 2&gt;/dev/null
rm -rf ~/Library/Caches/go-build/* 2&gt;/dev/null
rm -rf ~/Library/Caches/Cypress/* 2&gt;/dev/null
rm -rf ~/Library/Caches/ms-playwright/* 2&gt;/dev/null
rm -rf ~/.npm/_cacache/* 2&gt;/dev/null

# ─────────────────────────────────────────────
# Sistem &amp; Kullanıcı Önbellekleri
# ─────────────────────────────────────────────
rm -rf ~/Library/Logs/* 2&gt;/dev/null
rm -rf ~/Library/Caches/* 2&gt;/dev/null

# Geçici Dosyalar (3 günden eski)
USER_TEMP=$(getconf DARWIN_USER_TEMP_DIR 2&gt;/dev/null)
USER_CACHE_D=$(getconf DARWIN_USER_CACHE_DIR 2&gt;/dev/null)
[ -n "$USER_TEMP" ] &amp;&amp; find "$USER_TEMP" -mindepth 1 -type f -mtime +3 -delete 2&gt;/dev/null
[ -n "$USER_TEMP" ] &amp;&amp; find "$USER_TEMP" -mindepth 1 -type d -empty -delete 2&gt;/dev/null
[ -n "$USER_CACHE_D" ] &amp;&amp; find "$USER_CACHE_D" -mindepth 1 -type f -mtime +3 -delete 2&gt;/dev/null

# ─────────────────────────────────────────────
# Mesajlaşma &amp; Sosyal Uygulamalar
# ─────────────────────────────────────────────
# WhatsApp
rm -rf ~/Library/Containers/net.whatsapp.WhatsApp/Data/Library/Caches/* 2&gt;/dev/null
rm -rf ~/Library/Containers/desktop.WhatsApp/Data/Library/Caches/* 2&gt;/dev/null
rm -rf ~/Library/Group\ Containers/group.net.whatsapp.WhatsApp.shared/Library/Caches/* 2&gt;/dev/null

# Telegram
find ~/Library/Group\ Containers -maxdepth 1 -type d -name "*.ru.keepcoder.Telegram" | while read d; do
    rm -rf "$d/Library/Caches/"* 2&gt;/dev/null
    rm -rf "$d/account-"*/postbox/media/* 2&gt;/dev/null
done

# Discord
rm -rf ~/Library/Application\ Support/discord/Cache/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/discord/Code\ Cache/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/discord/Crashpad/* 2&gt;/dev/null

# Slack
rm -rf ~/Library/Application\ Support/Slack/Cache/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/Slack/Service\ Worker/CacheStorage/* 2&gt;/dev/null

# Spotify
rm -rf ~/Library/Application\ Support/Spotify/PersistentCache/* 2&gt;/dev/null

# Zoom
rm -rf ~/Library/Application\ Support/zoom.us/Logs/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/zoom.us/support/* 2&gt;/dev/null

# Microsoft Teams
rm -rf ~/Library/Application\ Support/Microsoft/Teams/Cache/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/Microsoft/Teams/blob_storage/* 2&gt;/dev/null

# ─────────────────────────────────────────────
# Tarayıcılar
# ─────────────────────────────────────────────
rm -rf ~/Library/Caches/com.apple.Safari/* 2&gt;/dev/null
rm -rf ~/Library/Caches/Google/Chrome/Default/Cache/* 2&gt;/dev/null
rm -rf ~/Library/Caches/Google/Chrome/Default/Media\ Cache/* 2&gt;/dev/null
find ~/Library/Caches/Firefox/Profiles -maxdepth 2 -type d -name "cache2" -exec rm -rf {}/* \; 2&gt;/dev/null
rm -rf ~/Library/Caches/Microsoft\ Edge/Default/Cache/* 2&gt;/dev/null

# ─────────────────────────────────────────────
# Geliştirici Araçları
# ─────────────────────────────────────────────
command -v docker &gt;/dev/null 2&gt;&amp;1 &amp;&amp; docker info &gt;/dev/null 2&gt;&amp;1 &amp;&amp; docker system prune -f 2&gt;/dev/null &amp;&amp; docker builder prune -f 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/Code/logs/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/Code/CachedData/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/Cursor/logs/* 2&gt;/dev/null
rm -rf ~/Library/Application\ Support/Cursor/CachedData/* 2&gt;/dev/null

# ─────────────────────────────────────────────
# Çöp Kutusu
# ─────────────────────────────────────────────
osascript -e 'tell application "Finder" to empty trash'

# ─────────────────────────────────────────────
# BİTİŞ BİLDİRİMİ
# ─────────────────────────────────────────────
osascript -e 'display notification "Adobe, DaVinci, sistem önbellekleri, tarayıcılar, mesajlaşma uygulamaları ve Çöp Kutusu temizlendi! ✅" with title "PC Temizleme Tamamlandı 🎉"'
</string>
